{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PVTA",
  "version": "1.5.4",
  "identifier": "vn.pvta.chatbox",
  "build": {
    "beforeDevCommand": "npm run build -w @pvta/addin && node ../scripts/build-sidecar.mjs && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node ../scripts/runtime/build.mjs && npm run build && npm run build -w @pvta/addin && node ../scripts/build-sidecar.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PVTA",
        "width": 1180,
        "height": 820,
        "minWidth": 720,
        "minHeight": 600,
        "backgroundColor": "#fbfaf7"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; media-src 'self' data: blob:; frame-src 'self' about:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/pvta-core",
      "binaries/pvta-brain"
    ],
    "resources": {
      "runtime/": "runtime/",
      "../../core/python/documents.py": "documents.py",
      "../../core/python/office.py": "office.py",
      "../../core/python/math_workshop.py": "math_workshop.py",
      "../../core/python/typesetting.py": "typesetting.py",
      "../../desktop-skills/": "desktop-skills/",
      "../../addin/dist/": "office-addin/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Trợ lý AI cho giáo viên",
    "category": "Productivity",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "windows": {
      "nsis": {
        "compression": "lzma",
        "displayLanguageSelector": true,
        "languages": [
          "Vietnamese",
          "English"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
