{
  "name": "@pvta/bridge",
  "version": "1.5.3",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --external:bufferutil --external:utf-8-validate --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\" --outfile=dist/pvta-bridge.mjs",
    "collect-feedback": "tsx src/communityCli.ts"
  },
  "dependencies": {
    "@pvta/shared": "*",
    "fflate": "^0.8.3",
    "node-forge": "^1.4.0",
    "ws": "^8.18.0",
    "@pvta/core": "*"
  },
  "devDependencies": {
    "@types/node-forge": "^1.3.14",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0"
  }
}
